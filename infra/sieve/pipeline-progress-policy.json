{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadPipelineProgressDocuments",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::6thsense-deploy-artifacts/raw-lifecycle/v1/config.json",
        "arn:aws:s3:::6thsense-processed/raw-lifecycle/v1/states/*.json",
        "arn:aws:s3:::6thsense-processed/raw-lifecycle/v1/audit/sieve-validation/sow1-20260916-independent-v2/FINAL-STATUS.json",
        "arn:aws:s3:::6thsense-processed/raw-lifecycle/v1/audit/sieve-validation/sow1-20260916-independent-v2/FINAL-VALIDATION.json",
        "arn:aws:s3:::6thsense-sieve/reports/sow1-20260915-batch-1/delivery/status.json",
        "arn:aws:s3:::6thsense-sieve/originals-review/sow1-20260916-supplement-v1/_audit/summary.json"
      ]
    },
    {
      "Sid": "ListPipelineProgressObjects",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::6thsense-processed",
      "Condition": {
        "StringEquals": {
          "s3:prefix": [
            "raw-lifecycle/v1/states/",
            "raw-lifecycle/v1/audit/sieve-validation/sow1-20260916-independent-v2/assets/"
          ]
        }
      }
    },
    {
      "Sid": "ReadSupplementDeliveryStatus",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::6thsense-sieve/reports/sow1-20260916-supplement-v1/delivery/status.json"
    }
  ]
}
