# Backend (FastAPI) environment. Copy to `.env` and fill in for local dev.
# In production these are set as Railway service variables — never commit real values.

# Postgres connection string. Railway injects it as ${{Postgres.DATABASE_URL}}.
# DATABASE_URL=postgresql://user:pass@localhost:5432/sixthsense

# Comma-separated origins allowed for CORS + the Origin CSRF check.
# SENSEPROBE_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Rate limits (slowapi syntax). Defaults: leads 5/minute, login 10/minute.
# SENSEPROBE_RATE_LIMIT=5/minute
# SENSEPROBE_LOGIN_RATE_LIMIT=10/minute

# Set to false only for local HTTP dev so the session cookie is sent without TLS.
# SENSEPROBE_COOKIE_SECURE=true

# Founder portal seed accounts (consumed once by alembic migration 0003).
# Password must be >= 12 chars. Repeat for FOUNDER_2_*, FOUNDER_3_*, FOUNDER_4_*.
# FOUNDER_1_EMAIL=founder@6thsense.dev
# FOUNDER_1_NAME=Founder One
# FOUNDER_1_PASSWORD=change-me-please

# Frontend build-time API base (baked into the bundle by `npm run build`).
# VITE_API_URL=https://api.6thsense.dev

# --- Data catalog -----------------------------------------------------------
# The buyer-facing catalog. Media lives in a PRIVATE S3 bucket; the API mints
# short-lived presigned GET URLs and the bytes go S3 -> browser directly.
# Provision the bucket + scoped IAM user with scripts/catalog/provision_s3.sh,
# then upload a built bundle with scripts/catalog/upload_bundle.py.

# `s3` (default, production) or `local` (development, no AWS at all).
# CATALOG_SOURCE=s3

# CATALOG_S3_BUCKET=6thsense-catalog-media
# CATALOG_S3_REGION=us-west-2
# Version prefix. Stage a re-cut corpus as v2/ and switch over by flipping this.
# CATALOG_S3_PREFIX=v1/
# Full package media referenced as media/* is signed from this processed tier.
# It shares the region and CATALOG_AWS_* read-only credentials above.
# CATALOG_PACKAGE_BUCKET=6thsense-processed
# CATALOG_PACKAGE_PREFIX=imported/2026-08-24_nervous-1/

# Access key for the catalog-media IAM user (scoped to this bucket only).
# BOTH must be set or NEITHER: setting one alone is a hard error, because
# falling through to the ambient AWS credential chain would sign catalog URLs
# with whatever AWS_* key is in the environment — including the firmware
# publishing key. Leave both unset on Railway to use an instance role.
# CATALOG_AWS_ACCESS_KEY_ID=
# CATALOG_AWS_SECRET_ACCESS_KEY=
# CATALOG_AWS_SESSION_TOKEN=

# Presigned URL lifetime in seconds (60 .. 604800). Returned to the client as
# `expires_at` so the UI can refetch the manifest before the signatures die.
# CATALOG_PRESIGN_TTL=900

# How long a parsed manifest/clip document is reused before revalidating
# against the object's ETag. 0 disables the cache.
# CATALOG_MANIFEST_TTL=60

# Object key of the manifest, relative to the prefix.
# CATALOG_MANIFEST_KEY=catalog.json

# S3-compatible endpoint (MinIO, LocalStack). Unset for real AWS.
# CATALOG_S3_ENDPOINT_URL=

# CATALOG_SOURCE=local only: the bundle directory `catalog_ingest build` wrote.
# This is what `npm run dev` should point at.
# CATALOG_LOCAL_DIR=/path/to/catalog/sample/bundle
# Optional stable HMAC key for local media URLs. Unset = random per process,
# which simply expires outstanding dev URLs on restart.
# CATALOG_LOCAL_SIGNING_KEY=
